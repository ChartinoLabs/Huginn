<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Huginn Test Report</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <header class="masthead">
      <div class="shell masthead-inner">
        <h1>Test Results Summary</h1>
      </div>
    </header>

    <main class="shell shell-main">
      <section class="card summary-card">
        <div class="section-header">
          <div>
            <h2>Executive Summary</h2>
          </div>
        </div>
        {% if run_metadata %}
        <dl class="summary-meta-row">
          {% for item in run_metadata %}
          <div class="summary-meta-item">
            <dt><span class="summary-chip">{{ item.label }}</span></dt>
            <dd>{{ item.value }}</dd>
          </div>
          {% endfor %}
        </dl>
        {% endif %}
        <div class="stats-grid">
          {% for stat in stats %}
          {% set slug = stat.label|lower|replace(' ', '-') %}
          <article class="metric-card metric-{{ slug }}">
            <span class="metric-label">{{ stat.label }}</span>
            <span class="metric-value">{{ stat.value }}</span>
          </article>
          {% endfor %}
        </div>
      </section>

      <section class="phase-list">
        {% for scenario in scenarios %}
        <details class="phase-card" data-filter-scope="scenario" {% if loop.first %}open{% endif %}>
          <summary class="phase-summary">
            <span class="object-kind-badge object-kind-badge-scenario">Scenario</span>
            <div class="phase-summary-main">
              <div class="phase-heading-row object-heading-row">
                <h2>{{ scenario.name }}</h2>
                <span class="status-pill status-pill-{{ scenario.status_class }}">
                  {{ scenario.status }}
                </span>
              </div>
            </div>
            <div class="phase-chip-row">
              {% for chip in scenario.chips %}
              <button
                type="button"
                class="phase-chip phase-chip-button{% if chip.action == 'clear' %} phase-chip-reset phase-chip-active{% endif %}"
                data-filter-chip
                data-filter-action="{{ chip.action }}"
                {% if chip.statuses %}data-filter-statuses="{{ chip.statuses|join(',') }}"{% endif %}
                aria-pressed="{{ 'true' if chip.action == 'clear' else 'false' }}"
              >{{ chip.label }}</button>
              {% endfor %}
            </div>
            <span class="phase-toggle" aria-hidden="true"></span>
          </summary>

          <div class="phase-body" data-filter-body>
            {% for phase in scenario.phases %}
            <details class="phase-nested-card" data-filter-scope="phase" {% if loop.first %}open{% endif %}>
              <summary class="phase-nested-summary">
                <span class="object-kind-badge object-kind-badge-phase">Phase</span>
                <div class="group-summary-main object-heading-row">
                  <h3>{{ phase.name }}</h3>
                  <span class="status-pill status-pill-{{ phase.status_class }}">
                    {{ phase.status }}
                  </span>
                </div>
                <div class="phase-chip-row">
                  {% for chip in phase.chips %}
                  <button
                    type="button"
                    class="phase-chip phase-chip-button{% if chip.action == 'clear' %} phase-chip-reset phase-chip-active{% endif %}"
                    data-filter-chip
                    data-filter-action="{{ chip.action }}"
                    {% if chip.statuses %}data-filter-statuses="{{ chip.statuses|join(',') }}"{% endif %}
                    aria-pressed="{{ 'true' if chip.action == 'clear' else 'false' }}"
                  >{{ chip.label }}</button>
                  {% endfor %}
                </div>
                <span class="phase-toggle" aria-hidden="true"></span>
              </summary>

              <div class="group-body" data-filter-body>
                {% for group in phase.groups %}
                <details class="group-card" data-filter-scope="group" {% if loop.first %}open{% endif %}>
                  <summary class="group-summary">
                    <span class="object-kind-badge object-kind-badge-group">Group</span>
                    <div class="group-summary-main object-heading-row">
                      <h4>{{ group.name }}</h4>
                      <span class="status-pill status-pill-{{ group.status_class }}">
                        {{ group.status }}
                      </span>
                    </div>
                    <div class="phase-chip-row">
                      {% for chip in group.chips %}
                      <button
                        type="button"
                        class="phase-chip phase-chip-button{% if chip.action == 'clear' %} phase-chip-reset phase-chip-active{% endif %}"
                        data-filter-chip
                        data-filter-action="{{ chip.action }}"
                        {% if chip.statuses %}data-filter-statuses="{{ chip.statuses|join(',') }}"{% endif %}
                        aria-pressed="{{ 'true' if chip.action == 'clear' else 'false' }}"
                      >{{ chip.label }}</button>
                      {% endfor %}
                    </div>
                    <span class="phase-toggle" aria-hidden="true"></span>
                  </summary>

                  <div class="group-body" data-filter-body>
                    {% for test_case in group.test_cases %}
                    <article class="test-card" data-test-status="{{ test_case.status }}">
                      <div class="test-card-header">
                        <div>
                          <h5 class="test-title">
                            <span class="test-id-inline">{{ test_case.test_id }}</span>
                            <span>{{ test_case.title }}</span>
                          </h5>
                        </div>
                        <span class="status-pill status-pill-{{ test_case.status_class }}">
                          {{ test_case.status }}
                        </span>
                      </div>

                      {% if test_case.commands %}
                      <div class="test-card-footer">
                        <div class="command-preview-block">
                          <p class="preview-label">Commands</p>
                          <ul class="command-preview-list">
                            {% for command in test_case.commands %}
                            <li>
                              <code>{{ command.command }}</code>
                            </li>
                            {% endfor %}
                          </ul>
                        </div>

                        <div class="test-card-actions">
                          <a class="action-link" href="{{ test_case.details_href }}">
                            View Details
                          </a>
                        </div>
                      </div>
                      {% else %}
                      <p class="empty-copy">
                        No command executions were recorded for this test case.
                      </p>
                      <div class="test-card-actions">
                        <a class="action-link" href="{{ test_case.details_href }}">
                          View Details
                        </a>
                      </div>
                      {% endif %}
                    </article>
                    {% endfor %}
                    <p class="filter-empty-state" data-filter-empty hidden>
                      No test cases match the selected statuses.
                    </p>
                  </div>
                </details>
                {% endfor %}
                <p class="filter-empty-state" data-filter-empty hidden>
                  No test cases match the selected statuses.
                </p>
              </div>
            </details>
            {% endfor %}
            <p class="filter-empty-state" data-filter-empty hidden>
              No test cases match the selected statuses.
            </p>
          </div>
        </details>
        {% endfor %}
      </section>
    </main>

    <script>
      (() => {
        const scopes = Array.from(document.querySelectorAll("[data-filter-scope]"));
        if (!scopes.length) {
          return;
        }

        const getControls = (scope) =>
          Array.from(scope.children).find((child) => child.matches("summary"));

        const getBody = (scope) =>
          Array.from(scope.children).find((child) => child.hasAttribute("data-filter-body"));

        const getEmptyState = (scope) => {
          const body = getBody(scope);
          if (!body) {
            return null;
          }
          return Array.from(body.children).find((child) => child.hasAttribute("data-filter-empty")) || null;
        };

        const getActiveStatuses = (scope) => {
          const controls = getControls(scope);
          const statuses = new Set();
          if (!controls) {
            return statuses;
          }
          controls
            .querySelectorAll("[data-filter-chip][aria-pressed='true'][data-filter-statuses]")
            .forEach((chip) => {
              chip.dataset.filterStatuses.split(",").forEach((status) => {
                statuses.add(status);
              });
            });
          return statuses;
        };

        const syncResetChip = (scope) => {
          const controls = getControls(scope);
          if (!controls) {
            return;
          }

          const resetChip = controls.querySelector("[data-filter-action='clear']");
          if (!resetChip) {
            return;
          }

          const hasActiveFilters = getActiveStatuses(scope).size > 0;
          resetChip.setAttribute("aria-pressed", hasActiveFilters ? "false" : "true");
          resetChip.classList.toggle("phase-chip-active", !hasActiveFilters);
        };

        const updateVisibility = () => {
          const testCards = Array.from(document.querySelectorAll(".test-card[data-test-status]"));

          scopes.forEach((scope) => {
            syncResetChip(scope);
          });

          testCards.forEach((card) => {
            const ancestorScopes = scopes.filter((scope) => scope.contains(card));
            const visible = ancestorScopes.every((scope) => {
              const activeStatuses = getActiveStatuses(scope);
              return !activeStatuses.size || activeStatuses.has(card.dataset.testStatus);
            });
            card.hidden = !visible;
          });

          scopes
            .slice()
            .reverse()
            .forEach((scope) => {
              const visibleTests = scope.querySelectorAll(".test-card[data-test-status]:not([hidden])");
              const hasVisibleTests = visibleTests.length > 0;
              const hasLocalFilters = getActiveStatuses(scope).size > 0;
              const emptyState = getEmptyState(scope);

              if (scope.dataset.filterScope !== "scenario") {
                scope.hidden = !hasVisibleTests && !hasLocalFilters;
              }

              if (emptyState) {
                emptyState.hidden = scope.hidden || hasVisibleTests;
              }
            });
        };

        document.querySelectorAll("[data-filter-chip]").forEach((chip) => {
          chip.addEventListener("click", (event) => {
            event.preventDefault();
            event.stopPropagation();

            const scope = chip.closest("[data-filter-scope]");
            if (!scope) {
              return;
            }

            if (chip.dataset.filterAction === "clear") {
              const controls = getControls(scope);
              if (!controls) {
                return;
              }
              controls.querySelectorAll("[data-filter-chip][aria-pressed='true']").forEach((button) => {
                button.setAttribute("aria-pressed", "false");
                button.classList.remove("phase-chip-active");
              });
              chip.setAttribute("aria-pressed", "true");
              chip.classList.add("phase-chip-active");
            } else {
              const isPressed = chip.getAttribute("aria-pressed") === "true";
              chip.setAttribute("aria-pressed", isPressed ? "false" : "true");
              chip.classList.toggle("phase-chip-active", !isPressed);
            }

            updateVisibility();
          });

          chip.addEventListener("keydown", (event) => {
            event.stopPropagation();
          });
        });

        updateVisibility();
      })();
    </script>
  </body>
</html>
